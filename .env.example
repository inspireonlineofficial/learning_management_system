# .env.example
#
# Copy this file to .env before running:
#   cp .env.example .env
#
# Replace all placeholder values before starting the application.
# Never commit .env or private keys to version control.

# =============================================================================
# Server
# =============================================================================

# HTTP listen port (default: 8080)
SERVER_PORT=8080

# Frontend URL used in password reset emails, CORS, and OAuth redirects
FRONTEND_BASE_URL=http://localhost:3000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=lms

# PostgreSQL connection string (host "postgres" when running under Docker Compose)
DATABASE_DSN=postgres://postgres:change_me_strong_password_here@postgres:5432/lms?sslmode=disable

# =============================================================================
# Redis
# =============================================================================

REDIS_PASSWORD=change_me_strong_redis_password_here
REDIS_URL=redis://:change_me_strong_redis_password_here@redis:6379

# =============================================================================
# Object Storage (S3-compatible / DigitalOcean Spaces / RustFS)
# =============================================================================

RUSTFS_ENDPOINT=https://sgp1.digitaloceanspaces.com
RUSTFS_ACCESS_KEY=your_object_storage_access_key_here
RUSTFS_SECRET_KEY=your_object_storage_secret_key_here
RUSTFS_REGION=us-east-1

RUSTFS_VIDEO_BUCKET=inspirelms
RUSTFS_FILES_BUCKET=inspirelms
RUSTFS_CERTIFICATES_BUCKET=inspirelms
RUSTFS_BOOKS_BUCKET=inspirelms
# Browser access for the PDF.js book reader and the HLS player. At startup the
# backend adds a GET/HEAD CORS rule (id "lms-frontend") for these origins to the
# books and video buckets, keeping any other rules. Defaults to
# FRONTEND_BASE_URL; comma-separate several. The storage key must be allowed to
# call PutBucketCors. Set STORAGE_CORS_AUTO=false to manage CORS yourself
# (make storage-cors). The admin System > Health page shows the result.
STORAGE_CORS_AUTO=true
STORAGE_CORS_ORIGINS=

# =============================================================================
# JWT (RS256)
# =============================================================================

# Paths to RSA key pair (mounted read-only at /app/keys in Docker Compose)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# JWT issuer claim (default: lms-backend)
JWT_ISSUER=lms-backend

# =============================================================================
# SMTP Email (required for OTPs, password resets and order emails)
# =============================================================================
# Production: any SMTP relay (Amazon SES, Mailgun, Postmark, Brevo, Google
# Workspace...). Port 587 uses STARTTLS (SMTP_TLS=starttls, the default);
# port 465 uses implicit TLS (SMTP_TLS=tls). The sender domain needs SPF and
# DKIM records from your provider or mail will land in spam. See docs/email.md.
# Local development: run the bundled mail server and use
#   SMTP_HOST=127.0.0.1 (or "mailsink" in docker compose) SMTP_PORT=1025 SMTP_TLS=none
# With SMTP_HOST empty, sending fails with an error (it no longer pretends).

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Inspire

# Local development admin OTP bypass (keep false in production)
ADMIN_DEV_BYPASS=false
ADMIN_DEV_OTP=000000

# =============================================================================
# OAuth Providers (optional)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/oauth/google/callback

# Optional encryption key for stored OAuth tokens (defaults to JWT_ISSUER if unset)
OAUTH_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Typesense Search
# =============================================================================

TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=change_me_typesense_api_key

# =============================================================================
# Video delivery
# =============================================================================

# presigned (default): backend-signed HLS playlists + presigned segment URLs
#   from the private bucket. Works everywhere; no edge caching (the Spaces CDN
#   does not cache presigned requests).
# bunny: token-authenticated Bunny CDN pull zone in front of the private bucket
#   (S3 origin auth). See docs/video/VIDEO_DELIVERY_OPTIMIZATION.md.
HLS_DELIVERY_MODE=presigned
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=

# =============================================================================
# Frontend
# =============================================================================

# Backend API base URL baked into local/Docker frontend builds
VITE_API_BASE_URL=http://localhost:8080
